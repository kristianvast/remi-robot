  <link name="sensor_pan">
    <visual>
      <geometry><mesh filename="meshes/sensor_pan_blue.stl"/></geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/sensor_pan_metal.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <origin xyz="-0.00780 0.00000 0.04100"/>
      <geometry><box size="0.00800 0.02800 0.04000"/></geometry>
      <material name="camera"/>
    </visual>
    <visual>
      <origin xyz="-0.01130 0.00000 0.03900"/>
      <geometry><box size="0.00300 0.03400 0.04500"/></geometry>
      <material name="acrylic"/>
    </visual>
    <collision>
      <origin xyz="0.00620 0.00000 0.02800"/>
      <geometry><box size="0.03800 0.04600 0.05000"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.00420 0.00000 0.02800"/>
      <mass value="0.03"/>
      <inertia ixx="1.154e-05" ixy="0" ixz="0" iyy="1.025e-05" iyz="0" izz="9.290e-06"/>
    </inertial>
  </link>
  <joint name="sensor_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="sensor_pan"/>
    <origin xyz="0.08530 0.00000 0.04575"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="0.18" velocity="5.2"/>
  </joint>
  <link name="ultrasonic_link"/>
  <joint name="ultrasonic_link_joint" type="fixed">
    <parent link="sensor_pan"/>
    <child link="ultrasonic_link"/>
    <origin xyz="0.02470 0.00000 0.02250"/>
  </joint>
  <link name="camera_link"/>
  <joint name="camera_link_joint" type="fixed">
    <parent link="sensor_pan"/>
    <child link="camera_link"/>
    <origin xyz="-0.00280 0.00000 0.04700"/>
  </joint>
  <link name="imu_link"/>
  <joint name="imu_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.01950 -0.02000 0.06875"/>
  </joint>
  <link name="line_tracker_link"/>
  <joint name="line_tracker_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="line_tracker_link"/>
    <origin xyz="0.09150 0.00000 -0.02965"/>
  </joint>
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin rpy="-1.5708 0 -1.5708"/>
  </joint>
</robot>
