    </collision>
    <inertial>
      <origin xyz="0.00000 0.00000 0.00000"/>
      <mass value="0.03"/>
      <inertia ixx="9.968e-06" ixy="0" ixz="0" iyy="1.663e-05" iyz="0" izz="9.968e-06"/>
