  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.04090 0.05800 0.00000"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.1" velocity="21"/>
  </joint>
  <link name="rear_right_wheel">
    <visual>
      <geometry><mesh filename="meshes/rear_right_wheel_metal.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/rear_right_wheel_wheel.stl"/></geometry>
      <material name="wheel"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0333" length="0.0257"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.00000 0.00000 0.00000"/>
      <mass value="0.03"/>
      <inertia ixx="9.968e-06" ixy="0" ixz="0" iyy="1.663e-05" iyz="0" izz="9.968e-06"/>
    </inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.04090 -0.05800 0.00000"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.1" velocity="21"/>
