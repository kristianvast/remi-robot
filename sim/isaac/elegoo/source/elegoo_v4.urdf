  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.04090 -0.05800 0.00000"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.1" velocity="21"/>
  </joint>
  <link name="rear_left_wheel">
    <visual>
      <geometry><mesh filename="meshes/rear_left_wheel_metal.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/rear_left_wheel_wheel.stl"/></geometry>
      <material name="wheel"/>
