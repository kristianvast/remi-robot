<?xml version="1.0"?>
<robot name="elegoo_smart_robot_car_v4">
  <material name="acrylic"><color rgba="0.08000 0.08000 0.08000 1.00000"/></material>
  <material name="motor"><color rgba="0.95000 0.80000 0.15000 1.00000"/></material>
  <material name="wheel"><color rgba="0.95000 0.85000 0.25000 1.00000"/></material>
  <material name="pcb"><color rgba="0.10000 0.35000 0.55000 1.00000"/></material>
  <material name="blue"><color rgba="0.15000 0.35000 0.85000 1.00000"/></material>
  <material name="metal"><color rgba="0.70000 0.70000 0.72000 1.00000"/></material>
  <material name="camera"><color rgba="0.05 0.05 0.05 1"/></material>
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.03330"/>
  </joint>
  <link name="base_link">
    <visual>
      <geometry><mesh filename="meshes/base_link_acrylic.stl"/></geometry>
      <material name="acrylic"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/base_link_blue.stl"/></geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/base_link_metal.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/base_link_motor.stl"/></geometry>
      <material name="motor"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/base_link_pcb.stl"/></geometry>
      <material name="pcb"/>
    </visual>
    <visual>
      <origin xyz="-0.07550 0.00100 0.04565"/>
      <geometry><box size="0.04200 0.08960 0.02500"/></geometry>
      <material name="acrylic"/>
    </visual>
    <collision>
      <origin xyz="-0.00050 0.00000 0.00875"/>
      <geometry><box size="0.23190 0.13220 0.04920"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.09150 0.00000 -0.02385"/>
      <geometry><box size="0.03500 0.04500 0.01150"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.03050 -0.00200 0.04575"/>
      <geometry><box size="0.15000 0.09000 0.02500"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.00550 0.00000 0.01375"/>
      <mass value="0.62"/>
      <inertia ixx="1.191e-03" ixy="0" ixz="0" iyy="3.072e-03" iyz="0" izz="3.681e-03"/>
    </inertial>
  </link>
  <link name="front_left_wheel">
    <visual>
      <geometry><mesh filename="meshes/front_left_wheel_metal.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/front_left_wheel_wheel.stl"/></geometry>
      <material name="wheel"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0333" length="0.0257"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.00000 0.00000 0.00000"/>
      <mass value="0.03"/>
      <inertia ixx="9.968e-06" ixy="0" ixz="0" iyy="1.663e-05" iyz="0" izz="9.968e-06"/>
    </inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.04090 0.05800 0.00000"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.1" velocity="21"/>
  </joint>
  <link name="front_right_wheel">
    <visual>
      <geometry><mesh filename="meshes/front_right_wheel_metal.stl"/></geometry>
      <material name="metal"/>
    </visual>
    <visual>
      <geometry><mesh filename="meshes/front_right_wheel_wheel.stl"/></geometry>
      <material name="wheel"/>
