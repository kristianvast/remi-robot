#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "elegoo_smart_robot_car_v4"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "elegoo_smart_robot_car_v4"
{
    over "Physics"
    {
        over "front_left_wheel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "front_right_wheel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rear_left_wheel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "rear_right_wheel_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "sensor_pan_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "front_left_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 0.10000000149011612
            uniform double mjc:forceRange:min = -0.10000000149011612
            custom rel mjc:target
            append rel mjc:target = </elegoo_smart_robot_car_v4/Physics/front_left_wheel_joint>
        }

        def MjcActuator "front_right_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 0.10000000149011612
            uniform double mjc:forceRange:min = -0.10000000149011612
            custom rel mjc:target
            append rel mjc:target = </elegoo_smart_robot_car_v4/Physics/front_right_wheel_joint>
        }

        def MjcActuator "rear_left_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 0.10000000149011612
            uniform double mjc:forceRange:min = -0.10000000149011612
            custom rel mjc:target
            append rel mjc:target = </elegoo_smart_robot_car_v4/Physics/rear_left_wheel_joint>
        }

        def MjcActuator "rear_right_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = 0.10000000149011612
            uniform double mjc:forceRange:min = -0.10000000149011612
            custom rel mjc:target
            append rel mjc:target = </elegoo_smart_robot_car_v4/Physics/rear_right_wheel_joint>
        }

        def MjcActuator "sensor_pan_joint_actuator"
        {
            uniform double mjc:forceRange:max = 0.18000000715255737
            uniform double mjc:forceRange:min = -0.18000000715255737
            custom rel mjc:target
            append rel mjc:target = </elegoo_smart_robot_car_v4/Physics/sensor_pan_joint>
        }
    }
}

