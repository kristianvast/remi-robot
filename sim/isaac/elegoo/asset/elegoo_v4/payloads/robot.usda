#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "elegoo_smart_robot_car_v4"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "elegoo_smart_robot_car_v4" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </elegoo_smart_robot_car_v4/Physics/front_left_wheel_joint>,
        </elegoo_smart_robot_car_v4/Physics/front_right_wheel_joint>,
        </elegoo_smart_robot_car_v4/Physics/rear_left_wheel_joint>,
        </elegoo_smart_robot_car_v4/Physics/rear_right_wheel_joint>,
        </elegoo_smart_robot_car_v4/Physics/sensor_pan_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </elegoo_smart_robot_car_v4/Geometry/base_footprint>,
        </elegoo_smart_robot_car_v4/Geometry/base_footprint/front_left_wheel>,
        </elegoo_smart_robot_car_v4/Geometry/base_footprint/front_right_wheel>,
        </elegoo_smart_robot_car_v4/Geometry/base_footprint/rear_left_wheel>,
        </elegoo_smart_robot_car_v4/Geometry/base_footprint/rear_right_wheel>,
        </elegoo_smart_robot_car_v4/Geometry/base_footprint/sensor_pan>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_footprint" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "front_left_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "front_right_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rear_left_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "rear_right_wheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "sensor_pan" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "front_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "sensor_pan_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

