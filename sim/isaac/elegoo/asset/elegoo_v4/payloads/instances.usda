    def Xform "base_link_acrylic" (
        prepend references = @./geometries.usd@</Geometries/base_link_acrylic>
    )
    {
        over "base_link_acrylic" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_link_acrylic/VisualMaterials/acrylic>
        }

        def Scope "VisualMaterials"
        {
            def Material "acrylic" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/acrylic>
            )
            {
            }
        }
    }

